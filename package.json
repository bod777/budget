{
  "name": "budget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json && npm run build --workspace web",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "import": "tsx --env-file-if-exists=.env scripts/import-csv.ts",
    "set-password": "tsx scripts/set-password.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace web",
    "dev-seed": "tsx scripts/dev-seed.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.2.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "workspaces": [
    "web"
  ]
}
