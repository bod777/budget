# Postgres connection string. Railway injects this automatically.
DATABASE_URL=postgresql://localhost:5432/budget_dev
# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# bcrypt hash of the app password. Generate with:
#   npm run set-password -- 'your password here'
APP_PASSWORD_HASH=
PORT=3000
