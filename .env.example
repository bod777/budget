# Postgres connection string. Railway injects this automatically.
DATABASE_URL=postgresql://localhost:5432/budget_dev
# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# bcrypt hash of the app password. Generate with:
#   npm run set-password -- 'your password here'
APP_PASSWORD_HASH=
PORT=3000

# Optional Google sign-in. All three are required to enable it; without
# ALLOWED_EMAIL the sign-in button stays hidden rather than admitting anyone
# with a Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=
# Origin used to build the OAuth redirect URI; Google matches it exactly.
PUBLIC_URL=

# Optional one-way mirror into a Google Sheet. Needs a service account (not the
# sign-in OAuth client) and a spreadsheet shared with its email as Editor.
# Raw JSON or base64 of the key file; base64 avoids newline mangling.
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_SPREADSHEET_ID=
